# ─────────────────────────────────────────────────────────────
# Vibecoders MCP — environment template
# Copy to `.env` and fill with YOUR OWN keys.  NEVER commit `.env`.
#
# On macOS, store secrets in the OS Keychain instead of a file —
#   vibecoders vault set OPENAI_API_KEY
# Keychain values override this file, are never written to disk,
# and are redacted from every log line. (`vault set` is macOS-only;
# on Linux/Windows this `.env` is the cross-platform path.)
#
# EVERY key is optional. The server runs with none — you only need a
# key for the specific capability or downstream server that uses it.
# These are always YOUR keys; vibecoders never ships or bills any.
# ─────────────────────────────────────────────────────────────

# Image generation + memory embeddings (optional):
OPENAI_API_KEY=

# Web search (gemini-api grounding) + memory embeddings (optional):
GEMINI_API_KEY=

# Web search alternatives (optional — pick one you have):
BRAVE_API_KEY=
TAVILY_API_KEY=

# Only needed by your own model/CLI auth or downstream MCP servers:
ANTHROPIC_API_KEY=
GITHUB_TOKEN=
VERCEL_TOKEN=
SUPABASE_ACCESS_TOKEN=

# ── Behavior (non-secret) — these also have config.json equivalents ──
VIBECODERS_LOG_LEVEL=info
# VIBECODERS_TIMEOUT_MS=60000
# VIBECODERS_HOME=~/.vibecoders          # where all state lives
# VIBECODERS_CONFIG=~/.vibecoders/config.json
# VIBECODERS_SERVERS=~/.vibecoders/servers.json
# Override a delegation CLI's command name if it isn't on PATH:
# VIBECODERS_CODEX_CMD=codex
# VIBECODERS_GEMINI_CMD=gemini
# VIBECODERS_CLAUDE_CMD=claude
